# Backend base URL. Empty = same origin; in dev Vite proxies /api to http://localhost:8000.
VITE_API_BASE=
# Optional Cesium ion token. When set, the "Cesium Mars" terrain mode (global 3D tileset) becomes available.
# Get one at https://ion.cesium.com/tokens . Never commit the real token.
VITE_CESIUM_ION_TOKEN=
