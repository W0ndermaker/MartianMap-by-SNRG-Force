# Path to the prepared (cropped, resampled) elevation GeoTIFF.
# Created by scripts/prepare_dem.py, e.g. data_raw/gale_dem.tif.
# Leave empty to run on synthetic terrain.
DEM_PATH=

# Comma-separated list of frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5173

# Port for local development.
PORT=8000
